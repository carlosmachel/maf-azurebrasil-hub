# Azure AI Project Configuration
# Get these values from your Azure AI Project in the Azure Portal

# Your Azure AI Project endpoint (format: https://<project-name>.<region>.api.azureml.ms)
AZURE_AI_PROJECT_ENDPOINT=https://your-project-name.region.api.azureml.ms

# The model deployment name (typically gpt-4o or gpt-4o-mini)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

